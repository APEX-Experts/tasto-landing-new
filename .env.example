# Connection string to postgres database that powers Payload CMS
DATABASE_URI=
# Secret key for connecting to Payload
PAYLOAD_SECRET=

# Storage Configuration
# Set to 'true' in production to use cloud storage, leave false/empty for local dev
USE_CLOUD_STORAGE=

# Cloud Storage Credentials (e.g., S3, Cloudflare R2, or GCS)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=comma,separated,email,list